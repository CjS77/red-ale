  <act:type>STOCK</act:type>
  <act:commodity>
    <cmdty:space>NASDAQ</cmdty:space>
    <cmdty:id>AAPL</cmdty:id>
  </act:commodity>
  <act:commodity-scu>1</act:commodity-scu>

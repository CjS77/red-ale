  </trn:date-entered>
  <trn:description>3:1 stock split with cash-in-lieu $4</trn:description>
  <trn:slots>
    <slot>
      <slot:key>date-posted</slot:key>
      <slot:value type="gdate">
        <gdate>1980-12-01</gdate>

            {
              "$ref": "#/$defs/SeriesKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "link": {
          "description": "A link for the whole series.",
          "anyOf": [
            {
              "$ref": "#/$defs/Link"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "description": "One link per value.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Link"
              },
              {
                "type": "null"
              }
            ]
          }

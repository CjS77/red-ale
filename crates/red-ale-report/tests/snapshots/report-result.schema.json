        "y": {
          "description": "y.",
          "$ref": "#/$defs/Rational"
        },
        "label": {
          "description": "The hover label's title.",
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "description": "Host: y as its hover label shows it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
